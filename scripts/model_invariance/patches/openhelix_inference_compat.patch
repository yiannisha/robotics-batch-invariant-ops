+def farthest_point_sampler(pos, npoints, start_idx=None):
+    """DGL-compatible FPS without its version-pinned extension."""
+    batch_size, num_points, _ = pos.shape
+    batch = torch.arange(batch_size, device=pos.device)
+    if start_idx is None:
+        current = torch.randint(
+            0, num_points - 1, (batch_size,), dtype=torch.long, device=pos.device
+        )
+    else:
+        current = torch.full(
+            (batch_size,), start_idx, dtype=torch.long, device=pos.device
+        )
+    minimum_distance = torch.full(
+        (batch_size, num_points), torch.inf, dtype=pos.dtype, device=pos.device
+    )
+    result = torch.empty(
+        (batch_size, npoints), dtype=torch.long, device=pos.device
+    )
+    for index in range(npoints):
+        result[:, index] = current
+        selected = pos[batch, current].unsqueeze(1)
+        distance = ((pos - selected) ** 2).sum(dim=-1)
+        minimum_distance = torch.minimum(minimum_distance, distance)
+        current = minimum_distance.argmax(dim=-1)
+    return result
+
